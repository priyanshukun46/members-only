<div class="min-h-screen bg-[#f5f5f7] flex items-center justify-center px-4">
  <div class="w-full max-w-xl rounded-3xl bg-white p-10 shadow-sm">

    <h1 class="mb-8 text-4xl font-semibold text-gray-900">
      <%= post.persisted? ? "Edit Post" : "Create a Post" %>
    </h1>

    <%= form_with model: post do |f| %>

      <% if post.errors.any? %>
        <div class="mb-6 rounded-xl bg-red-50 p-4 text-red-700">
          <ul class="list-disc pl-5">
            <% post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-5">
        <%= f.text_field :title,
            placeholder: "Title",
            class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-black focus:outline-none" %>
      </div>

      <div class="mb-6">
        <%= f.text_area :content,
            rows: 8,
            placeholder: "What's on your mind?",
            class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-black focus:outline-none resize-none" %>
      </div>

      <%= f.submit class: "w-full rounded-full bg-black py-3 text-white font-medium hover:bg-gray-800 transition" %>

    <% end %>

  </div>
</div>
